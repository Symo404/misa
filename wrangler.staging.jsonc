{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misa-staging",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "staging",
    "INQUIRIES_ENABLED": "false",
    "EMAIL_PROVIDER": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misa-staging",
      "database_id": "6da21fa3-b5ae-4a39-959e-b35e3de553e2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "misa-staging-private"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
